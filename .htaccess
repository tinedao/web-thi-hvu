# .htaccess - Tối ưu và cấu hình Reverse Proxy & URL Rewriting cho AZDIGI (LiteSpeed / Apache)
RewriteEngine On

# 0. Website đang TẮT (Master Admin) -> chặn luôn kết nối chat /ws
RewriteCond %{DOCUMENT_ROOT}/data/site_disabled.lock -f
RewriteRule ^ws(/.*)?$ - [R=404,L]

# 1. Chuyển tiếp kết nối /ws tới Node.js Server (cả WebSocket và HTTP Health Check)
RewriteCond %{HTTP:Upgrade} =websocket [NC]
RewriteRule ^ws/?(.*)$ ws://127.0.0.1:8085/$1 [P,L]

RewriteCond %{HTTP:Upgrade} !=websocket [NC]
RewriteRule ^ws/?(.*)$ http://127.0.0.1:8085/$1 [P,L]

# 2. Định tuyến các trang chức năng từ thư mục pages/ (hỗ trợ cả URL có đuôi .php và không có đuôi)
RewriteCond %{DOCUMENT_ROOT}/pages/$1.php -f [OR]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(login|portal|dashboard|logout|role_switch)(\.php)?$ pages/$1.php [L,QSA]

# 3. Định tuyến AJAX tập trung từ thư mục includes/
RewriteRule ^(ajax_handler)(\.php)?$ includes/ajax_handler.php [L,QSA]

# 4. Định tuyến tài nguyên tĩnh (assets tương thích ngược URL cũ)
RewriteRule ^style\.css$ assets/css/style.css [L]
RewriteRule ^script\.js$ assets/js/script.js [L]
RewriteRule ^websocket-client\.js$ assets/js/websocket-client.js [L]
RewriteRule ^img/(.*)$ assets/img/$1 [L]
RewriteRule ^font/(.*)$ assets/font/$1 [L]

# 5. Bảo vệ các tệp cơ sở dữ liệu SQLite và cấu hình nhạy cảm
<FilesMatch "(\.sqlite|\.sqlite3|\.db|\.env|\.log|\.lock|\.sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 6. Chặn xem trực tiếp cấu trúc thư mục
Options -Indexes
