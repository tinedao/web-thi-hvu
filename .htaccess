# .htaccess - Tối ưu và cấu hình Reverse Proxy cho AZDIGI (LiteSpeed / Apache)
RewriteEngine On

# 1. Chuyển tiếp kết nối WebSocket /ws tới Node.js WebSocket Server (cổng 8085 cục bộ)
RewriteCond %{HTTP:Upgrade} =websocket [NC]
RewriteCond %{HTTP:Connection} =Upgrade [NC]
RewriteRule ^ws/?(.*)$ ws://127.0.0.1:8085/$1 [P,L]

# 2. Bảo vệ các tệp cơ sở dữ liệu SQLite và cấu hình nhạy cảm
<FilesMatch "(\.sqlite|\.sqlite3|\.db|\.env)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 3. Chặn xem trực tiếp cấu trúc thư mục
Options -Indexes
